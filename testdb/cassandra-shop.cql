-- A sample shop for trying TablePeek on Cassandra and ScyllaDB: partition
-- and clustering keys (descending order), a static column, a counter table,
-- collections, a UDT, tuples, durations, inet, uuid and timeuuid keys, a
-- materialized view, a secondary index, awkward names and enough rows to
-- page through. Run after testdb/{cassandra,scylladb}-keyspaces.cql made
-- the keyspace; the engine tests don't read it.
USE shop;

CREATE TYPE address (street text, city text, zip text, country text);

CREATE TABLE categories (
    id int PRIMARY KEY,
    parent_id int,
    name text,
    slug text
) WITH comment = 'Product categories; parent_id makes a tree';

CREATE TABLE customers (
    id int PRIMARY KEY,
    email text,
    full_name text,
    country text,
    tier text,
    is_active boolean,
    preferences map<text, text>,
    tags set<text>,
    signed_up_at timestamp,
    address frozen<address>,
    note text
);

CREATE TABLE products (
    id int PRIMARY KEY,
    category_id int,
    sku text,
    name text,
    price decimal,
    stock int,
    tags list<text>,
    attributes map<text, text>,
    dimensions tuple<float, float, float>,
    thumbnail blob,
    released_on date,
    discontinued boolean
);
CREATE INDEX products_category ON products (category_id);

-- A customer's orders, newest first.
CREATE TABLE orders (
    customer_id int,
    ordered_at timestamp,
    id bigint,
    status text,
    shipped_at timestamp,
    shipping_address frozen<address>,
    coupon_code text,
    PRIMARY KEY ((customer_id), ordered_at, id)
) WITH CLUSTERING ORDER BY (ordered_at DESC, id ASC);

CREATE MATERIALIZED VIEW orders_by_status AS
    SELECT status, customer_id, ordered_at, id, coupon_code
    FROM orders
    WHERE status IS NOT NULL AND customer_id IS NOT NULL AND ordered_at IS NOT NULL AND id IS NOT NULL
    PRIMARY KEY ((status), customer_id, ordered_at, id);

CREATE TABLE order_items (
    order_id bigint,
    line_no smallint,
    product_id int,
    quantity int,
    unit_price decimal,
    PRIMARY KEY ((order_id), line_no)
);

-- Counters live in tables of their own.
CREATE TABLE product_views (
    product_id int,
    day date,
    views counter,
    PRIMARY KEY ((product_id), day)
);

-- A time series: one partition per sensor and day, a static name per
-- partition.
CREATE TABLE sensor_readings (
    sensor_id uuid,
    bucket date,
    at timeuuid,
    sensor_name text static,
    reading double,
    source inet,
    latency duration,
    PRIMARY KEY ((sensor_id, bucket), at)
);

-- Names and values that need quoting or escaping (a table name takes only
-- letters, digits and underscores; its case needs the quotes).
CREATE TABLE "EdgeCases" (
    id int PRIMARY KEY,
    "Mixed Case" text,
    "한글 컬럼" text,
    "with space" text,
    "quote""inside" text,
    big_number varint,
    precise decimal,
    tiny tinyint,
    small smallint,
    tiny_real float,
    happened_on date,
    happened_time time,
    raw blob,
    nested map<text, frozen<list<int>>>
);

